{
  "xsappname": "productmanagementapi",
  "tenant-mode": "dedicated",

  "scopes": [
    {
      "name": "$XSAPPNAME.admin",
      "description": "Darf POST, PUT und DELETE aufrufen"
    },
    {
      "name": "$XSAPPNAME.viewer",
      "description": "Darf nur GET aufrufen"
    }
  ],

  "role-templates": [
    {
      "name": "ProductManagementAdmin",
      "description": "Vollzugriff auf die API",
      "scope-references": [
        "$XSAPPNAME.admin",
        "$XSAPPNAME.viewer"
      ]
    },
    {
      "name": "ProductManagementViewer",
      "description": "Nur lesender Zugriff",
      "scope-references": [
        "$XSAPPNAME.viewer"
      ]
    }
  ],

  "role-collections": [
    {
      "name": "ProductManagement_Admin",
      "description": "Administratoren der Anwendung",
      "role-template-references": [
        "$XSAPPNAME.ProductManagementAdmin"
      ]
    },
    {
      "name": "ProductManagement_Viewer",
      "description": "Lesende Nutzer der Anwendung",
      "role-template-references": [
        "$XSAPPNAME.ProductManagementViewer"
      ]
    }
  ]
}
